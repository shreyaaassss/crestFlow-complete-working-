# =============================================================================
# CrestFlow Treasury — Environment Variables
#
# Deployment: GitHub Actions → AWS ECS Fargate (ap-south-1)
#             Docker images in ECR, served via CloudFront + ALB
#
# LOCAL DEVELOPMENT:  Copy this file to .env and fill in values.
# PRODUCTION:         All vars are injected via GitHub Secrets at build/deploy
#                     time in .github/workflows/deploy.yml — do NOT commit .env
#
# GitHub Secrets to configure (Settings → Secrets → Actions):
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
#   VITE_API_URL, VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_ADMIN_EMAIL
#   JWT_SECRET, SUPABASE_SERVICE_ROLE_KEY, ADMIN_API_KEY
#   DEPLOYER_MNEMONIC, ORCHESTRATOR_MNEMONIC
# =============================================================================

# ─── Algorand Network ─────────────────────────────────────────────────────────
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=

INDEXER_SERVER=https://testnet-idx.algonode.cloud
INDEXER_PORT=443

# "testnet" (default) | "mainnet"
NETWORK=testnet

# ─── Accounts ─────────────────────────────────────────────────────────────────
# Deployer: deploys + admin-configures contracts (runs locally, not in ECS)
DEPLOYER_MNEMONIC=word1 word2 ... word25

# Orchestrator: automated invest/redeem service (runs in ECS — use GitHub Secret)
ORCHESTRATOR_MNEMONIC=word1 word2 ... word25

# Platform receives yield on every completed order
PLATFORM_WALLET_ADDRESS=ALGO_ADDRESS_HERE

# ─── Smart Contract IDs ───────────────────────────────────────────────────────
# UPDATE THESE after each contract redeploy
ESCROW_APP_ID=762780212
TBILL_APP_ID=762780155

# ─── T-Bill ASA IDs (7 maturity tiers) ───────────────────────────────────────
# UPDATE THESE after each TBill contract redeploy (create_tbill_asas_short/long)
TBILL_1D_ASA=762780183
TBILL_3D_ASA=762780184
TBILL_7D_ASA=762780185
TBILL_14D_ASA=762780186
TBILL_30D_ASA=762780197
TBILL_60D_ASA=762780198
TBILL_90D_ASA=762780199

# ─── Orchestrator Config ──────────────────────────────────────────────────────
# Poll interval in milliseconds.
# After Issue 1 fix the effective interval is exactly this value
# (cycle execution time is subtracted from sleep). Use 10000 (10s) for demos.
POLL_INTERVAL_MS=30000
MIN_ORDER_AMOUNT_MICROALGO=5000000

# ─── Backend API ──────────────────────────────────────────────────────────────
BACKEND_PORT=3002
# CHANGE THIS IN PRODUCTION — injected via GitHub Secret JWT_SECRET in ECS
JWT_SECRET=cadencia-dev-secret-change-in-prod

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://yetssyjyhmujmxefwxvh.supabase.co
# Service role key (full DB access — use GitHub Secret in ECS, NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Anon/publishable key (RLS-restricted — safe for frontend, injected as VITE_SUPABASE_ANON_KEY)
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ─── Admin Auth ───────────────────────────────────────────────────────────────
# Backend: used by API middleware to verify admin identity
ADMIN_EMAIL=admin@crestflow.com
# Secret key for internal admin API endpoints (/platform/stats, /platform/config)
ADMIN_API_KEY=change-me-in-production

# ─── Frontend Build Args (injected via --build-arg in GitHub Actions) ─────────
# These are VITE_ prefixed so Vite bakes them into the frontend bundle at build time.
# In production they are passed as Docker --build-arg from GitHub Secrets.
# For local dev set them here (prefix VITE_ is required by Vite).
VITE_API_URL=http://localhost:3002
VITE_SUPABASE_URL=https://yetssyjyhmujmxefwxvh.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# REQUIRED — if absent, NO ONE can access the admin dashboard (fail-closed).
# Set as GitHub Secret VITE_ADMIN_EMAIL and injected via docker --build-arg.
VITE_ADMIN_EMAIL=admin@crestflow.com

# ─── CORS / Frontend Origin ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for the backend CORS policy.
# In production: CloudFront HTTPS URL + ALB HTTP URL (set in deploy.yml directly)
FRONTEND_URL=http://localhost:5173

# ─── Yield Backend ────────────────────────────────────────────────────────────
# "reserve"       (default) — pre-funded on-chain reserve, no external DeFi calls
# "folks-finance" — Folks Finance v2 ALGO lending pool (mainnet Phase 2, stub only)
YIELD_BACKEND=reserve
# Required when YIELD_BACKEND=folks-finance (mainnet only):
# FOLKS_ALGO_POOL_APP_ID=<Folks Finance v2 ALGO Pool App ID on mainnet>

# ─── Oracle Backend ───────────────────────────────────────────────────────────
# "mock" (default) — hardcoded values, no real oracle calls
# "gora"           — live ALGO/USD + Folks Finance APY via Gora DQS (mainnet Phase 2)
ORACLE_BACKEND=mock
# Required when ORACLE_BACKEND=gora (mainnet only):
# GORA_MAIN_APP_ID=<Gora mainnet main app ID>
# GORA_DEST_APP_ID=<Your ARC-4 callback destination app ID>
# GORA_TOKEN_ASSET_ID=<GORA token ASA ID>
# MIN_USD_ORDER_VALUE=1.0

# ─── Swap Backend ─────────────────────────────────────────────────────────────
# "mock"    (default) — simulated ALGO→USDC quote at $0.18/ALGO, no real swap
# "tinyman" — live ALGO→USDC swap via Tinyman v2 AMM (mainnet Phase 3, stub only)
SWAP_BACKEND=mock
# Required when SWAP_BACKEND=tinyman (mainnet only):
# TINYMAN_APP_ID=1002541853   # Tinyman v2 validator app ID (mainnet)
# USDC_ASA_ID=31566704        # USDC ASA on Algorand mainnet
# SWAP_SLIPPAGE_BPS=50        # Slippage tolerance: 50 bps = 0.5%

# ─── AWS Infrastructure (reference only — managed by GitHub Actions) ──────────
# These values are hardcoded in deploy.yml and aws/setup.sh.
# They are listed here for reference only — you do NOT set them in .env.
# AWS_REGION=ap-south-1
# ECR_REGISTRY=385467777110.dkr.ecr.ap-south-1.amazonaws.com
# ECS_CLUSTER=crestflow-cluster
# BACKEND_URL=https://dwn69a9pf40yt.cloudfront.net
# FRONTEND_URL_PROD=https://d3sy24wytumdht.cloudfront.net

# ─── Mainnet Contract IDs (populate after mainnet deploy) ────────────────────
# MAINNET_ESCROW_APP_ID=
# MAINNET_TBILL_APP_ID=
# MAINNET_TBILL_1D_ASA=
# MAINNET_TBILL_3D_ASA=
# MAINNET_TBILL_7D_ASA=
# MAINNET_TBILL_14D_ASA=
# MAINNET_TBILL_30D_ASA=
# MAINNET_TBILL_60D_ASA=
# MAINNET_TBILL_90D_ASA=
# MAINNET_PLATFORM_WALLET_ADDRESS=
# MAINNET_ORCHESTRATOR_MNEMONIC=word1 word2 ... word25
